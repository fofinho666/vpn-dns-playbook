[Unit]
Description=Re-insert loopback ACCEPT after UFW (nftables chain-wiring workaround)
After=ufw.service
PartOf=ufw.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -i lo -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I INPUT 1 -i lo -j ACCEPT'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
