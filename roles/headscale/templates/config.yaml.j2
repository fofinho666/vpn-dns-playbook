server_url: https://{{ headscale.subdomain }}.{{ domain }}
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 0.0.0.0:9090

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: false
  # Static DERP map pinned locally (roles/headscale/files/derp.yaml). Headscale
  # must NOT fetch https://controlplane.tailscale.com/derpmap/default: that
  # hostname is DNS-sinkholed by the LAN filter, and a failed DERPMap fetch is
  # fatal -> Headscale crash-loops on startup and the whole tailnet goes down.
  urls: []
  paths:
    - /var/lib/headscale/derp.yaml
  auto_update_enabled: false
  update_frequency: 24h

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite

log:
  format: text
  level: info

dns:
  magic_dns: true
  override_local_dns: false
  base_domain: ts.{{ domain }}
  nameservers:
    global: []
    split:
      {{ domain }}:
        - {{ local_dns }}
  search_domains:
    - {{ domain }}
